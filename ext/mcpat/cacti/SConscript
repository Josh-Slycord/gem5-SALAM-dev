# CACTI integration for gem5-SALAM

Import('env')

# External libraries are evaluated for each configured build variant in gem5
# 26.  Mutate that exported variant, not the pre-variant main environment.
if env['CONF']['USE_ARM_ISA'] and env.get('WITH_SALAM', False):
    cacti_env = env.Clone()
    cacti_env.Append(CPPDEFINES=['NTHREADS=8'])

    # Keep warnings from this third-party library local to its own sources.
    if cacti_env['GCC'] or cacti_env['CLANG']:
        cacti_env.Append(CCFLAGS=['-w'])

    # main.cc is the standalone CACTI executable and must not enter gem5.
    cacti_sources = [
        'Ucache.cc',
        'arbiter.cc',
        'area.cc',
        'bank.cc',
        'basic_circuit.cc',
        'cacti_interface.cc',
        'component.cc',
        'crossbar.cc',
        'decoder.cc',
        'htree2.cc',
        'io.cc',
        'mat.cc',
        'nuca.cc',
        'parameter.cc',
        'router.cc',
        'subarray.cc',
        'technology.cc',
        'uca.cc',
        'wire.cc',
    ]

    cacti_env.Library(
        'cacti', [cacti_env.SharedObject(source) for source in cacti_sources]
    )

    env.Prepend(CPPPATH=Dir('.').srcnode())
    env.Append(LIBS=['cacti'])
    env.Prepend(LIBPATH=[Dir('.')])
